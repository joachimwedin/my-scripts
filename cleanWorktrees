#!/usr/bin/env bash
# Iterates over every git repo directly under $REPOS_DIR and cleans up its
# git worktrees.
#
# For each repo, every worktree other than the main one is bucketed:
#   - prune    directory is already gone; only stale metadata remains
#   - locked   `git worktree lock`ed -- never touched, never prompted
#   - safe     no uncommitted/untracked changes, and the branch is merged
#              into the repo's default branch or fully pushed -- removed
#              automatically under --force, no prompt
#   - confirm  a worktree still exists but isn't provably safe (dirty tree,
#              and/or commits not merged or not pushed) -- --force prompts
#              per-worktree before removing
# Branches are never deleted, only worktrees.
#
# Defaults to a dry run that only lists what would happen in each bucket.
# Pass --force to actually prune, remove the safe ones, and prompt for the
# rest.
#
# Usage:
#   cleanWorktrees              # dry run -- lists prune/locked/safe/confirm per repo
#   cleanWorktrees --force      # prunes, removes safe worktrees, prompts for the rest

set -euo pipefail

REPOS_DIR="${REPOS_DIR:-$HOME/repos}"
FORCE=false

for arg in "$@"; do
  case "$arg" in
    --force) FORCE=true ;;
    *) echo "Unknown argument: $arg" >&2; exit 1 ;;
  esac
done

if [[ "$FORCE" == false ]]; then
  echo "Dry run -- no worktrees will be modified. Pass --force to actually clean up."
  echo
fi

total_pruned=0
total_removed=0

# Emits one line per worktree registered in $1 (tab-separated: path, branch
# or "(detached)", locked 0/1, prunable 0/1, prunable/locked reason). The
# first line is always the repo's main worktree.
parse_worktrees() {
  git -C "$1" worktree list --porcelain | awk '
    function flush() {
      if (path != "") printf "%s\t%s\t%d\t%d\t%s\n", path, branch, locked, prunable, reason
    }
    BEGIN { path=""; branch="(detached)"; locked=0; prunable=0; reason="" }
    /^worktree / { flush(); path=substr($0,10); branch="(detached)"; locked=0; prunable=0; reason="" }
    /^branch /   { branch=$0; sub(/^branch refs\/heads\//,"",branch) }
    /^locked/    { locked=1; reason=substr($0,8) }
    /^prunable/  { prunable=1; reason=substr($0,10) }
    END { flush() }
  '
}

# Prints a ref to compare a worktree's branch against for "merged" status:
# origin/HEAD's target if set, else local main, else local master. Prints
# nothing if none of those resolve -- callers then treat merged status as
# unconfirmed rather than guessing.
default_branch_ref() {
  local repo_dir="$1"
  local ref
  ref="$(git -C "$repo_dir" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [[ -n "$ref" ]]; then
    echo "$ref"
    return 0
  fi
  if git -C "$repo_dir" show-ref -q --verify refs/heads/main; then
    echo "main"
    return 0
  fi
  if git -C "$repo_dir" show-ref -q --verify refs/heads/master; then
    echo "master"
    return 0
  fi
  return 0
}

# Prints, semicolon-separated, the reasons $1 needs confirmation before
# removal. Prints nothing if it's safe to remove automatically.
unsafe_reasons() {
  local wt_path="$1" default_ref="$2"
  local reasons=()

  if [[ -n "$(git -C "$wt_path" status --porcelain)" ]]; then
    reasons+=("uncommitted/untracked changes")
  fi

  local merged=false
  if [[ -n "$default_ref" ]] && git -C "$wt_path" merge-base --is-ancestor HEAD "$default_ref" 2>/dev/null; then
    merged=true
  fi

  if [[ "$merged" == false ]]; then
    local upstream
    upstream="$(git -C "$wt_path" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
    if [[ -z "$upstream" ]]; then
      reasons+=("not merged into ${default_ref:-a known default branch}, no upstream to confirm it's pushed")
    else
      local ahead
      ahead="$(git -C "$wt_path" rev-list --count "${upstream}..HEAD")"
      if [[ "$ahead" -gt 0 ]]; then
        reasons+=("$ahead commit(s) ahead of $upstream, not merged into $default_ref")
      fi
    fi
  fi

  local reasons_str=""
  for r in "${reasons[@]}"; do
    if [[ -z "$reasons_str" ]]; then
      reasons_str="$r"
    else
      reasons_str="$reasons_str; $r"
    fi
  done
  echo "$reasons_str"
}

header_shown=false
show_repo_header() {
  if [[ "$header_shown" == false ]]; then
    echo "== $repo_name =="
    header_shown=true
  fi
}

for repo_dir in "$REPOS_DIR"/*/; do
  [[ -d "$repo_dir/.git" ]] || continue
  repo_name="$(basename "$repo_dir")"
  header_shown=false

  records=()
  while IFS= read -r line; do
    records+=("$line")
  done < <(parse_worktrees "$repo_dir")
  default_ref="$(default_branch_ref "$repo_dir")"

  # Pass 1: list (and count) prunable worktrees, then prune them all at once.
  prunable_count=0
  for ((i = 1; i < ${#records[@]}; i++)); do
    IFS=$'\t' read -r wt_path wt_branch wt_locked wt_prunable wt_reason <<< "${records[$i]}"
    [[ "$wt_prunable" == "1" ]] || continue
    show_repo_header
    echo "  [prune]   $wt_path -- $wt_reason"
    prunable_count=$((prunable_count + 1))
  done
  if [[ "$prunable_count" -gt 0 && "$FORCE" == true ]]; then
    git -C "$repo_dir" worktree prune -v
    total_pruned=$((total_pruned + prunable_count))
  fi

  # Pass 2: classify every remaining linked worktree as locked/safe/confirm.
  for ((i = 1; i < ${#records[@]}; i++)); do
    IFS=$'\t' read -r wt_path wt_branch wt_locked wt_prunable wt_reason <<< "${records[$i]}"
    [[ "$wt_prunable" == "1" ]] && continue

    if [[ "$wt_locked" == "1" ]]; then
      show_repo_header
      if [[ -n "$wt_reason" ]]; then
        echo "  [locked]  $wt_path ($wt_branch) -- $wt_reason -- never touched"
      else
        echo "  [locked]  $wt_path ($wt_branch) -- never touched"
      fi
      continue
    fi

    reasons="$(unsafe_reasons "$wt_path" "$default_ref")"

    if [[ -z "$reasons" ]]; then
      show_repo_header
      echo "  [safe]    $wt_path ($wt_branch) -- would remove"
      if [[ "$FORCE" == true ]]; then
        git -C "$repo_dir" worktree remove "$wt_path"
        echo "  -> removed"
        total_removed=$((total_removed + 1))
      fi
    else
      show_repo_header
      echo "  [confirm] $wt_path ($wt_branch) -- $reasons"
      if [[ "$FORCE" == true ]]; then
        reply="n"
        read -r -p "  Remove anyway? [y/N] " reply < /dev/tty 2>/dev/null || reply="n"
        if [[ "$reply" =~ ^[Yy]$ ]]; then
          git -C "$repo_dir" worktree remove --force "$wt_path"
          echo "  -> removed"
          total_removed=$((total_removed + 1))
        else
          echo "  -> skipped"
        fi
      fi
    fi
  done

  [[ "$header_shown" == true ]] && echo
done

if [[ "$FORCE" == true ]]; then
  echo "Done. Pruned $total_pruned stale worktree(s), removed $total_removed worktree(s)."
else
  echo "Dry run complete. Re-run with --force to prune/remove/confirm the worktrees listed above."
fi
