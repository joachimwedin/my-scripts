#!/usr/bin/env bash
# Cleans up git worktrees across every repo under $REPOS_DIR -- see
# src/cli.ts for behavior. This shim resolves its own install location
# independent of the caller's working directory, then runs the entry point
# directly through the locally installed tsx (no npx, no build step), so the
# command works from any directory.
#
# Usage:
#   cleanWorktreesTs              # dry run -- lists prune/locked/safe/confirm per repo
#   cleanWorktreesTs --force      # prunes, removes safe worktrees, prompts for the rest

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)

exec "$SCRIPT_DIR/node_modules/.bin/tsx" "$SCRIPT_DIR/src/cli.ts" "$@"
