#!/usr/bin/env bash
# Iterates over every git repo directly under $REPOS_DIR and clears its stash.
#
# Defaults to a dry run that only lists what would be dropped. Pass --force
# to actually clear stashes.
#
# Usage:
#   /clearStashes              # dry run — lists stashes per repo
#   /clearStashes --force      # actually runs `git stash clear`

set -euo pipefail

REPOS_DIR="${REPOS_DIR:-$HOME/repos}"
FORCE=false

for arg in "$@"; do
  case "$arg" in
    --force) FORCE=true ;;
    *) echo "Unknown argument: $arg" >&2; exit 1 ;;
  esac
done

if [[ "$FORCE" == false ]]; then
  echo "Dry run — no stashes will be modified. Pass --force to actually clear them."
  echo
fi

total_cleared=0

for dir in "$REPOS_DIR"/*/; do
  [[ -d "$dir/.git" ]] || continue
  repo_name="$(basename "$dir")"

  stash_list="$(git -C "$dir" stash list)"
  [[ -z "$stash_list" ]] && continue

  stash_count="$(echo "$stash_list" | wc -l)"
  echo "== $repo_name ($stash_count stash(es)) =="
  echo "$stash_list"

  if [[ "$FORCE" == true ]]; then
    git -C "$dir" stash clear
    echo "-> cleared"
    total_cleared=$((total_cleared + stash_count))
  fi
  echo
done

if [[ "$FORCE" == true ]]; then
  echo "Done. Cleared $total_cleared stash(es) total."
else
  echo "Dry run complete. Re-run with --force to clear the stashes listed above."
fi
