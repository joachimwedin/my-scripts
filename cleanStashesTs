#!/usr/bin/env bash
# Clears git stashes across every repo under $REPOS_DIR -- see
# src/cleanStashes/main.ts for behavior. This shim resolves its own install
# location independent of the caller's working directory, then runs the
# entry point directly through the locally installed tsx (no npx, no build
# step), so the command works from any directory.
#
# Usage:
#   cleanStashesTs              # dry run -- lists stashes per repo
#   cleanStashesTs --force      # clears stashes across every repo

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)

exec "$SCRIPT_DIR/node_modules/.bin/tsx" "$SCRIPT_DIR/src/cleanStashes/main.ts" "$@"
